		Handle.Size = UDim2.new(0, 12, 0, 12)

		UICorner_Handle.CornerRadius = UDim.new(1, 0)
		UICorner_Handle.Parent = Handle

		HandleStroke.Color = Color3.fromRGB(99, 102, 241)
		HandleStroke.Thickness = 1
		HandleStroke.Parent = Handle

		Button.Parent = SliderFrame
		Button.BackgroundTransparency = 1
		Button.Size = UDim2.new(1, 0, 1, 0)
		Button.Text = ""
		Button.ZIndex = 5

		local currentValue = default
		local isDragging = false

		local function updateSlider(customPct)
			local pct = customPct or math.clamp((currentValue - min) / (max - min), 0, 1)
			Fill.Size = UDim2.new(pct, 0, 1, 0)
			Handle.Position = UDim2.new(pct, 0, 0.5, 0)
			local displayValue = math.floor(currentValue)
			ValueLabel.Text = tostring(displayValue)
			if callback then callback(displayValue) end
		end

		local function processInput(input)
			local trackX = TrackBack.AbsolutePosition.X
			local trackW = TrackBack.AbsoluteSize.X
			local pct = math.clamp((input.Position.X - trackX) / trackW, 0, 1)
			currentValue = min + pct * (max - min)
			updateSlider(pct)
		end

		Button.MouseEnter:Connect(function()
			TweenService:Create(SliderFrame, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(25, 25, 38)}):Play()
			TweenService:Create(UIStroke_Sld, TweenInfo.new(0.15), {Color = Color3.fromRGB(80, 80, 110)}):Play()
			TweenService:Create(Handle, TweenInfo.new(0.15), {Size = UDim2.new(0, 14, 0, 14)}):Play()
		end)

		Button.MouseLeave:Connect(function()
			if not isDragging then
				TweenService:Create(SliderFrame, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(20, 20, 28)}):Play()
				TweenService:Create(UIStroke_Sld, TweenInfo.new(0.15), {Color = Color3.fromRGB(45, 45, 60)}):Play()
				TweenService:Create(Handle, TweenInfo.new(0.15), {Size = UDim2.new(0, 12, 0, 12)}):Play()
			end
		end)

		Button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				isDragging = true
				processInput(input)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				processInput(input)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				isDragging = false
				TweenService:Create(SliderFrame, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(20, 20, 28)}):Play()
				TweenService:Create(UIStroke_Sld, TweenInfo.new(0.15), {Color = Color3.fromRGB(45, 45, 60)}):Play()
				TweenService:Create(Handle, TweenInfo.new(0.15), {Size = UDim2.new(0, 12, 0, 12)}):Play()
			end
		end)

		currentValue = default
		updateSlider()

		local SliderObject = {}
		function SliderObject:Set(val)
			currentValue = math.clamp(val, min, max)
			updateSlider()
		end
		
		function SliderObject:Get()
			return currentValue
		end
		return SliderObject
	end

