			TweenService:Create(InputBox, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 42)}):Play()
			TweenService:Create(UIStroke_Box, TweenInfo.new(0.2), {Color = Color3.fromRGB(50, 50, 70)}):Play()
			if callback then
				callback(InputBox.Text)
			end
		end)

		local InputObject = {}
		function InputObject:Set(value)
			InputBox.Text = value
			if callback then callback(value) end
		end
		
		function InputObject:Get()
			return InputBox.Text
		end
		return InputObject
	end

	function lib:CreateLabel(title, ParentCanvas)
		local LabelFrame = Instance.new("Frame")
		local UICorner_Lbl = Instance.new("UICorner")
		local UIStroke_Lbl = Instance.new("UIStroke")
		local TitleLabel = Instance.new("TextLabel")
		local LeftAccent = Instance.new("Frame")

		LabelFrame.Name = "Label"
		LabelFrame.Parent = ParentCanvas
		LabelFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
		LabelFrame.Size = UDim2.new(0.95, 0, 0, IsMobile and 32 or 35)

		UICorner_Lbl.CornerRadius = UDim.new(0, 8)
		UICorner_Lbl.Parent = LabelFrame

		UIStroke_Lbl.Color = Color3.fromRGB(40, 40, 55)
		UIStroke_Lbl.Thickness = 1
		UIStroke_Lbl.Parent = LabelFrame

		LeftAccent.Name = "LeftAccent"
		LeftAccent.Parent = LabelFrame
		LeftAccent.BackgroundColor3 = Color3.fromRGB(99, 102, 241)
		LeftAccent.BorderSizePixel = 0
		LeftAccent.Position = UDim2.new(0, 0, 0.15, 0)
		LeftAccent.Size = UDim2.new(0, 4, 0.7, 0)

		local AccentCorner = Instance.new("UICorner")
		AccentCorner.CornerRadius = UDim.new(1, 0)
		AccentCorner.Parent = LeftAccent

		local AccentGradient = Instance.new("UIGradient")
		AccentGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(99, 102, 241)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(168, 85, 247))
		})
		AccentGradient.Parent = LeftAccent

		TitleLabel.Name = "Title"
		TitleLabel.Parent = LabelFrame
		TitleLabel.BackgroundTransparency = 1
		TitleLabel.Position = UDim2.new(0, 15, 0, 0)
		TitleLabel.Size = UDim2.new(1, -30, 1, 0)
		TitleLabel.Font = Enum.Font.GothamMedium
		TitleLabel.Text = title
		TitleLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
		TitleLabel.TextSize = 14
		TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

		return LabelFrame
	end

	return lib
end

return lib
